# Optional process environment configuration. Do not commit your real .env.
# Prefer configuring through the local workbench Settings page.
# If using this file: copy to .env, fill it, then load it in your shell before starting.
TRACELENS_TDP_URL=
TRACELENS_TDP_KEY=
TRACELENS_TDP_SECRET=
# Optional Chat Completions base URL (the app appends /chat/completions)
TRACELENS_AI_URL=
TRACELENS_AI_MODEL=
TRACELENS_AI_KEY=
# Optional internal CA certificate path; TLS verification always remains enabled.
# TRACELENS_CA_FILE=/absolute/path/to/internal-ca.pem
# Optional local data directory, outside the source checkout.
# TRACELENS_DATA_DIR=/absolute/path/to/private-data
